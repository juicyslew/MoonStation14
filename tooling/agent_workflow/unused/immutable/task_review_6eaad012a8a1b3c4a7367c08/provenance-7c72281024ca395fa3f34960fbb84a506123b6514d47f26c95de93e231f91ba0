{
  "task_id": "task_review_6eaad012a8a1b3c4a7367c08",
  "run_id": "run_308e7fe87cb722363064aa9b",
  "evaluation_generation": 1,
  "assignment_generation": 1,
  "input_digest": "0031e70533ea8d49f62f7439b9f4e1766ac088cc5bb7c9cf33fa170d30b8f106",
  "assignment_artifact_refs": [],
  "instruction": "Return the canonical review_result JSON. inspected_refs must cite original assignment refs. FAIL findings require required_change.",
  "review_result_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contract_version",
      "task_id",
      "run_id",
      "evaluation_generation",
      "assignment_generation",
      "input_digest",
      "decision",
      "findings",
      "inspected_refs"
    ],
    "properties": {
      "contract_version": {
        "const": 1
      },
      "task_id": {
        "type": "string",
        "pattern": "^task_.+"
      },
      "run_id": {
        "type": "string",
        "pattern": "^run_.+"
      },
      "evaluation_generation": {
        "$ref": "#/$defs/generation"
      },
      "assignment_generation": {
        "$ref": "#/$defs/generation"
      },
      "input_digest": {
        "$ref": "#/$defs/digest"
      },
      "decision": {
        "enum": [
          "PASS",
          "FAIL"
        ]
      },
      "findings": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/finding"
        }
      },
      "inspected_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "decision": {
              "const": "FAIL"
            }
          }
        },
        "then": {
          "properties": {
            "findings": {
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/finding"
                  },
                  {
                    "required": [
                      "required_change"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "decision": {
              "const": "PASS"
            }
          }
        },
        "then": {
          "properties": {
            "findings": {
              "minItems": 1,
              "items": {
                "not": {
                  "required": [
                    "required_change"
                  ]
                }
              }
            }
          }
        }
      }
    ]
  },
  "finding_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "criterion_id",
      "category",
      "message",
      "location",
      "evidence_refs"
    ],
    "properties": {
      "criterion_id": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "enum": [
          "IMPLEMENTATION",
          "PARITY_COMPOSITION",
          "COVERAGE",
          "FIDELITY"
        ]
      },
      "message": {
        "type": "string",
        "minLength": 1
      },
      "location": {
        "type": "string",
        "minLength": 1
      },
      "evidence_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/ref"
        }
      },
      "required_change": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "evidence": []
}
