    "deviceLinkSource": { "ports": ["moonstation14:air_danger", "moonstation14:air_warning", "moonstation14:air_normal"], "lastSignals": { "moonstation14:air_danger": "LOW", "moonstation14:air_warning": "LOW", "moonstation14:air_normal": "HIGH" } }
