      "WIDE_FILTERING": {"ventEnabled":true,"externalTargetKPa":101.325,"pressureLockoutOverride":false,"scrubberEnabled":true,"scrubberMode":"FILTER","scrubberRateM3PerSecond":0.2,"filterGases":["plasma","tritium","carbon_dioxide","nitrous_oxide","ammonia","frezon","water_vapor"],"wideNet":true},
      "FILL": {"ventEnabled":true,"externalTargetKPa":5066.25,"pressureLockoutOverride":true,"scrubberEnabled":false,"scrubberMode":"FILTER","scrubberRateM3PerSecond":0.2,"filterGases":["plasma","tritium","carbon_dioxide","nitrous_oxide","ammonia","frezon","water_vapor"],"wideNet":false},
      "PANIC": {"ventEnabled":false,"externalTargetKPa":101.325,"pressureLockoutOverride":false,"scrubberEnabled":true,"scrubberMode":"SIPHON","scrubberRateM3PerSecond":0.2,"filterGases":["plasma","tritium","carbon_dioxide","nitrous_oxide","ammonia","frezon","water_vapor"],"wideNet":true},
      "NONE": {"ventEnabled":false,"externalTargetKPa":101.325,"pressureLockoutOverride":false,"scrubberEnabled":false,"scrubberMode":"FILTER","scrubberRateM3PerSecond":0.2,"filterGases":["plasma","tritium","carbon_dioxide","nitrous_oxide","ammonia","frezon","water_vapor"],"wideNet":false}
