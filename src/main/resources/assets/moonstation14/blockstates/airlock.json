{
  "multipart": [
    { "when": { "half": "lower", "open": "false", "facing": "north" }, "apply": { "model": "moonstation14:block/airlock_closed", "y": 0 } },
    { "when": { "half": "lower", "open": "false", "facing": "east" }, "apply": { "model": "moonstation14:block/airlock_closed", "y": 90 } },
    { "when": { "half": "lower", "open": "false", "facing": "south" }, "apply": { "model": "moonstation14:block/airlock_closed", "y": 180 } },
    { "when": { "half": "lower", "open": "false", "facing": "west" }, "apply": { "model": "moonstation14:block/airlock_closed", "y": 270 } },
    { "when": { "half": "lower", "open": "true", "facing": "north" }, "apply": { "model": "moonstation14:block/airlock_open", "y": 0 } },
    { "when": { "half": "lower", "open": "true", "facing": "east" }, "apply": { "model": "moonstation14:block/airlock_open", "y": 90 } },
    { "when": { "half": "lower", "open": "true", "facing": "south" }, "apply": { "model": "moonstation14:block/airlock_open", "y": 180 } },
    { "when": { "half": "lower", "open": "true", "facing": "west" }, "apply": { "model": "moonstation14:block/airlock_open", "y": 270 } }
  ]
}
