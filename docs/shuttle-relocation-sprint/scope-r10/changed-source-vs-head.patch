+            COMPARISON_DIRECTORY: 10,
+            REGRESSION_DIRECTORY: 10,
+            DIAGNOSTIC_DIRECTORY: 10,
+            COST_SUBSTEPS2_DIRECTORY: 2,
+            COST_SUBSTEPS10_DIRECTORY: 10,
